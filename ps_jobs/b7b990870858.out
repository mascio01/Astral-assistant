##### def get_cache_read_price @ 5979
def get_cache_read_price(model):
    """USD/1M per i token di input serviti dalla cache del provider.

    Ritorna None se il modello non espone un prezzo di cache: in quel caso il
    chiamante deve trattare quei token a prezzo pieno (stima conservativa).
    """
    if not model:
        return None
    m = str(model).strip().lower()
    return _catalog_raw()[1].get(m)


def cost_usd(model, prompt_tokens, completion_tokens, cached_tokens=0):
    """Costo totale USD della chiamata; None se prezzo sconosciuto.

    `cached_tokens` sono i token di prompt serviti dalla cache del provider:
    vanno scorporati dal totale prompt e tariffati al prezzo di cache quando
    noto. Se il prezzo di cache manca restano a prezzo pieno (stima alta ma
    mai inferiore al vero). `cached_tokens` viene comunque limitato a
    `prompt_tokens` perche' alcuni provider riportano valori incoerenti.
    """
    p = get_price(model)
    if p is None:
        return None
    pt = int(prompt_tokens or 0)
    ct = int(completion_tokens or 0)
    cached = max(0, min(int(cached_tokens or 0), pt))
    cr = get_cache_read_price(model) if cached else None
    if cr is None:
        # Nessun prezzo di cache noto: i token restano a prezzo pieno.
        cr = p[0]
    return ((pt - cached) / 1000000.0) * p[0] \
        + (cached / 1000000.0) * cr \
        + (ct / 1000000.0) * p[1]


def all_prices():
    """Lista [(match, prompt, completion)] ordinata alfabeticamente."""
    return sorted((k, v[0], v[1]) for k, v in PRICES.items())


