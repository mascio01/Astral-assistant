414: def test_g03_invalidazione_esplicita():
415:     with Sandbox() as box:
416:         KM.refresh_knowledge_map()
417:         first = box.snapshot()["generation_id"]
418:         KM.invalidate()
419:         assert box.snapshot()["generation_id"] != first
