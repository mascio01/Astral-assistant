134: def test_km02_disponibilita_esplicita():
135:     with Sandbox() as box:
136:         KM.refresh_knowledge_map()
137:         pricing = box.record("api_pricing")
138:         assert pricing["status"] == "active" and pricing["availability"] == "missing"
139:         assert pricing["freshness"] == "unknown"
140:         missing = {item["pattern"]: item for item in pricing["sources_missing"]}
141:         assert missing[".or_models_cache.json"]["required"]
142:         assert missing[".lb_table_*.csv"]["reason"] == "not_found"
143:         box.touch("benchmark_data.py")
144:         KM.refresh_if_needed(force=True)
145:         benchmark = box.record("model_benchmarks")
146:         assert benchmark["availability"] == "partial", benchmark["availability"]
