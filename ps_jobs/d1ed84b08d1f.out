149: def test_km02_rimozione_fonte_segnalata():
150:     with Sandbox() as box:
151:         box.touch(".routing_personal_scores.json")
152:         KM.refresh_knowledge_map()
153:         os.remove(box.path(".routing_personal_scores.json"))
154:         KM.refresh_if_needed(force=True)
155:         removed = box.record("routing_history")["auto"]["removed_since_last_snapshot"]
156:         assert [item["path"] for item in removed] == [".routing_personal_scores.json"]
157:         assert removed[0]["sha256"], "evidenza della fonte rimossa persa"
158:         kinds = [item["kind"] for item in KM.diagnostics()["problems"]]
159:         assert "source_removed" in kinds
