1471:             # Live Sliding Window respiratorio: finestra sinusoidale + ledger (v2)
1472:             messages = safe_trim_context(messages)
1473:             if last_meta.get("event") == "consolidate":
1474:                 console.print(f"[dim][*] Respirazione: consolidamento (ciclo #{last_meta['cycle']}, "
1475:                               f"{last_meta['facts']} fatti attivi, finestra {last_meta['window']} turni).[/dim]")
1476: 
1477:             try:
1478:                 response, used_model = call_with_dynamic_fallback(
1479:                     messages,
1480:                     tools_schema=gateway.select_schemas(user_input, context=messages),
1481:                     primary_model=active_model)
1482:             except Exception as e:
1483:                 console.print(f"[orange_red1]{escape(str(e))}[/red]")
1484:                 try:
1485:                     from routing_engine import record_model_penalty, classify_input
1486:                     record_model_penalty(
1487:                         used_model if "used_model" in locals() else active_model,
1488:                         classify_input(user_input)[0],
1489:                         reason=f"llm_request_failed: {e}",
1490:                         weight=0.75,
1491:                     )
1492:                 except Exception:
1493:                     pass
1494:                 if messages and messages[-1].get("role") == "user":
1495:                     messages.pop()
1496:                 continue
1497: 
1498:             usage = getattr(response, "usage", None)
1499:             record_usage(used_model, usage)  # Fase 3 UsageTracker (silenzioso)
1500:             # Il routing usa lo usage reale anche per il primo tentativo: il
1501:             # log storico viene aggiornato prima della prossima decisione.
1502:             print_telemetry(response, used_model)
1503:             msg = response.choices[0].message
1504: 
1505:             # Gestione tool calls senza limite rigido: continua fino alla risposta finale del modello
