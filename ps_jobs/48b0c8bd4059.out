134: def _utc_now():
135:     return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()
136: 
137: 
138: def _sha256_file(path, limit=MAX_SOURCE_BYTES):
139:     digest = hashlib.sha256()
140:     total = 0
141:     with open(path, "rb") as stream:
142:         for chunk in iter(lambda: stream.read(1024 * 1024), b""):
143:             total += len(chunk)
144:             if total > limit:
145:                 return "", total
