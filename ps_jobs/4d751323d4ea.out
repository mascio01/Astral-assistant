16: 
17: sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
18: 
19: from core import knowledge_map as KM
20: from _test_support import Patcher, cleanup, run_all, temp_dir
21: 
22: 
23: class Sandbox(object):
24:     """Isola knowledge_map in una cartella temporanea (nessun dato reale toccato)."""
25: 
26:     def __init__(self):
27:         self.folder = temp_dir("astral_km_")
28:         self.patcher = Patcher()
29: 
30:     def __enter__(self):
31:         keys = {"ROOT": self.folder, "CATALOG_JSON": self.path("knowledge_catalog.json"),
32:                 "CATALOG_LOCAL": self.path("knowledge_catalog.local.json"),
33:                 "MAP_JSON": self.path("knowledge_map.json"),
34:                 "MAP_MD": self.path("knowledge_map.md"),
35:                 "LOCK_FILE": self.path(".knowledge_map.lock")}
36:         for name, value in keys.items():
37:             self.patcher.set(KM, name, value)
38:         KM._last.update({"error": "", "refresh_at": 0.0, "warnings": [], "partial": False})
39:         return self
40: 
41:     def __exit__(self, *exc):
42:         self.patcher.restore()
43:         cleanup(self.folder)
44:         return False
45: 
46:     def path(self, name):
47:         return os.path.join(self.folder, name)
48: 
49:     def write(self, name, text):
50:         with open(self.path(name), "w", encoding="utf-8") as stream:
51:             stream.write(text)
52:         return self.path(name)
53: 
54:     def write_json(self, name, payload):
55:         return self.write(name, json.dumps(payload, ensure_ascii=False))
56: 
57:     def snapshot(self):
58:         with open(self.path("knowledge_map.json"), encoding="utf-8") as stream:
59:             return json.load(stream)
60: 
61:     def record(self, rid):
62:         for record in self.snapshot()["records"]:
63:             if record["id"] == rid:
64:                 return record
65:         raise AssertionError("record mancante: %s" % rid)
66: 
67:     def touch(self, name, content="dato"):
68:         self.write(name, content)
69:         return name
70: 
