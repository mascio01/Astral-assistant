1: # -*- coding: utf-8 -*-
2: # test_knowledge_map.py - Fase 1 (KM01-KM10 + G03): integrita' della knowledge map.
3: # Copre: conservazione dei dati curati, migrazione v1, disponibilita' e freschezza
