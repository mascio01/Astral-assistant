175: def test_km03_hash_cambiato_richiede_revisione():
176:     with Sandbox() as box:
177:         box.touch("price_map.py", "uno")
178:         KM.refresh_knowledge_map()
179:         data = box.snapshot()
180:         for record in data["records"]:
181:             record["semantic"]["reviewed_at"] = "2026-09-01T00:00:00+00:00"
182:             record["semantic"]["reviewed_sources"] = {
183:                 item["id"]: item["sha256"] for item in record["sources"]}
184:         box.write_json("knowledge_map.json", data)
185:         KM.refresh_if_needed(force=True)
186:         assert box.record("api_pricing")["review"] == "current"
187:         box.touch("price_map.py", "due")
188:         KM.refresh_if_needed(force=True)
189:         pricing = box.record("api_pricing")
190:         assert pricing["review"] == "needs_review"
191:         assert any(item.get("changed_since_last_snapshot") for item in pricing["sources"])
192: 
