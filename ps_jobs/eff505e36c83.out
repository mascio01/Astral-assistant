163: def test_km03_freschezza_usa_data_fonte_e_policy():
164:     with Sandbox() as box:
165:         box.write_json(".or_models_cache.json", {"ts": 100.0, "models": []})
166:         box.touch(".lb_table_2026_06_25.csv")
167:         KM.refresh_knowledge_map()
168:         pricing = box.record("api_pricing")
169:         assert pricing["freshness"] == "expired", pricing["freshness"]
170:         or_source = [item for item in pricing["sources"] if item["path"] == ".or_models_cache.json"][0]
171:         assert or_source["source_updated_at"].startswith("1970-01-01")
172:         assert or_source["observed_at"] == or_source["source_updated_at"]
173: 
