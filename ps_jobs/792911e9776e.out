516:         accepted = [item for item in names if item["allowed"]]
517:         rejected.extend({"id": definition["id"], "pattern": definition["pattern"],
518:                          "path": item["path"], "reason": item["reason"]}
519:                         for item in names if not item["allowed"])
520:         if not accepted:
521:             reason = error or ("rejected:" + ",".join(i["reason"] for i in names)
522:                                if names else "not_found")
523:             missing.append({"id": definition["id"], "pattern": definition["pattern"],
524:                             "role": definition["role"], "required": definition["required"],
525:                             "reason": reason})
526:             if definition["required"]:
527:                 required_missing = True
528:             continue
529:         for item in accepted:
530:             meta = _source_meta(item["path"], definition, previous_sources.get(item["path"]))
531:             if not meta["available"]:
532:                 unreadable = True
533:             resolved.append(meta)
534:             days = definition.get("freshness_days")
535:             if days:
536:                 freshness_marks.append(_is_fresh(meta["observed_at"], days, now))
537:     if not resolved:
538:         availability = "missing"
539:     elif unreadable:
540:         availability = "unreadable"
541:     elif required_missing or missing:
542:         availability = "partial"
543:     else:
544:         availability = "ready"
545:     if freshness_marks:
546:         freshness = "fresh" if all(freshness_marks) else "expired"
547:     else:
548:         freshness = "unknown"
