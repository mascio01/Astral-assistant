282: def test_km07_pattern_non_autorizzato_rifiutato():
283:     with Sandbox() as box:
284:         outside = temp_dir("astral_km_out_")
285:         try:
286:             box.write("knowledge_catalog.json", json.dumps({
287:                 "schema_version": KM.SCHEMA_VERSION,
288:                 "records": [{"id": "malevolo", "topic": "Malevolo",
289:                              "description": "fuori root",
290:                              "sources": [{"pattern": "../*.json", "role": "data"}]}]}))
291:             KM.refresh_knowledge_map()
292:             ids = [record["id"] for record in box.snapshot()["records"]]
293:             assert "malevolo" not in ids, "pattern fuori root accettato"
294:             status = KM.diagnostics()
295:             assert status["catalog"]["state"] == "invalid"
296:             assert any("non autorizzato" in error for error in status["catalog"]["errors"])
297:         finally:
298:             cleanup(outside)
299: 
300: 
301: def test_km07_symlink_rifiutato():
302:     with Sandbox() as box:
303:         outside = temp_dir("astral_km_out_")
304:         try:
305:             secret = os.path.join(outside, "secret.json")
306:             with open(secret, "w", encoding="utf-8") as stream:
307:                 stream.write('{"ts": 1, "segreti": true}')
308:             link = box.path(".or_models_cache.json")
309:             try:
310:                 os.symlink(secret, link)
311:             except (OSError, NotImplementedError, AttributeError):
312:                 return  # symlink non disponibili: test saltato (Windows senza privilegi)
313:             KM.refresh_knowledge_map()
314:             pricing = box.record("api_pricing")
315:             assert all(item["path"] != ".or_models_cache.json" for item in pricing["sources"])
316:             rejected = pricing["auto"]["rejected"]
317:             assert any("symlink" in item["reason"] for item in rejected), rejected
318:             assert "segreti" not in json.dumps(box.snapshot())
319:         finally:
320:             cleanup(outside)
321: 
322: 
323: # --- KM08: writer coordinati ---------------------------------------------------
324: def test_km08_scritture_concorrenti_producono_json_valido():
325:     with Sandbox() as box:
326:         box.touch(".or_models_cache.json", json.dumps({"ts": 100.0}))
