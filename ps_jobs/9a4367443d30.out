246: def _load_catalog():
247:     """Default + knowledge_catalog.json + catalogo locale, con validazione."""
248:     errors = []
249:     warnings = []
250:     file_data, state = _read_json(CATALOG_JSON)
251:     if state in ("corrupt", "unreadable"):
252:         _backup_corrupt(CATALOG_JSON, "corrupt")
253:         errors.append("knowledge_catalog.json %s: uso i default + il locale" % state)
254:         file_data = {}
255:     local_data, local_state = _read_json(CATALOG_LOCAL)
256:     if local_state in ("corrupt", "unreadable"):
257:         _backup_corrupt(CATALOG_LOCAL, "corrupt")
258:         errors.append("knowledge_catalog.local.json %s: personalizzazioni non caricate"
259:                       % local_state)
260:         local_data = {}
261:     for label, payload in (("catalog", file_data), ("local", local_data)):
262:         declared = payload.get("schema_version") if isinstance(payload, dict) else None
263:         if isinstance(declared, int) and declared > SCHEMA_VERSION:
264:             errors.append("%s schema_version %s non supportata: ignorato" % (label, declared))
265:             if label == "catalog":
266:                 file_data = {}
267:             else:
268:                 local_data = {}
269:     records = _merge_records(DEFAULT_CATALOG["records"], file_data.get("records"))
270:     records = _merge_records(records, local_data.get("records"))
271:     valid, invalid = [], []
272:     for record in records:
273:         problems = _validate_record(record)
274:         if problems:
275:             invalid.append({"id": (record or {}).get("id") if isinstance(record, dict) else None,
276:                             "problems": problems})
277:         else:
278:             valid.append(_normalize_record(record))
279:     for item in invalid:
280:         errors.append("record %s non valido: %s" % (item["id"], "; ".join(item["problems"])))
281:     grouped = {}
282:     for record in valid:
283:         grouped.setdefault(record["id"], []).append(record)
284:     duplicated = sorted(key for key, items in grouped.items() if len(items) > 1)
285:     if duplicated:
286:         errors.append("ID duplicati ignorati: %s" % ", ".join(duplicated))
287:     valid = [items[0] for items in grouped.values()]
288:     default_ids = {str(record["id"]) for record in DEFAULT_CATALOG["records"]}
289:     for record in valid:
290:         if record["id"] not in default_ids:
291:             record["origin"] = "custom"
292:     unknown_ids = sorted({rid for record in valid for rid in record["related_ids"]
293:                           if rid not in grouped})
294:     if unknown_ids:
295:         warnings.append("related_ids senza record: %s" % ", ".join(unknown_ids))
296:     return {"records": valid, "errors": errors, "warnings": warnings,
297:             "state": "ok" if not errors else "invalid"}
