449:         return ""
450:     if not isinstance(data, dict):
451:         return ""
452:     try:
453:         stamp = datetime.datetime.fromtimestamp(float(data.get(field)),
454:                                                 datetime.timezone.utc)
455:     except (TypeError, ValueError, OverflowError, OSError):
456:         return ""
457:     return stamp.replace(microsecond=0).isoformat()
458: 
459: 
460: def _source_meta(name, definition, previous):
461:     path = os.path.join(ROOT, name)
462:     meta = {"id": definition["id"], "path": name.replace(os.sep, "/"),
463:             "role": definition["role"], "required": definition["required"],
464:             "available": False, "sha256": "", "size_bytes": 0, "mtime": "",
465:             "source_updated_at": "", "observed_at": "", "reason": ""}
466:     try:
467:         stat = os.stat(path)
468:     except OSError as exc:
469:         meta["reason"] = type(exc).__name__
470:         return meta
471:     meta["size_bytes"] = stat.st_size
472:     meta["mtime"] = datetime.datetime.fromtimestamp(stat.st_mtime).isoformat(timespec="seconds")
473:     meta["source_updated_at"] = _source_updated_at(name, path)
474:     meta["observed_at"] = meta["source_updated_at"] or meta["mtime"]
475:     try:
476:         digest, size = _sha256_file(path)
477:     except OSError as exc:
478:         meta["reason"] = type(exc).__name__
479:         return meta
480:     if not digest:
481:         meta["reason"] = "too_large"
482:         meta["size_bytes"] = size
483:         return meta
484:     meta["sha256"] = digest
485:     meta["available"] = True
486:     if previous and previous.get("sha256") and previous["sha256"] != digest:
487:         meta["changed_since_last_snapshot"] = True
488:     return meta
