451: 
452: # ---------------------------------------------------------------------------
453: # Fase 3 - UsageTracker: contabilita' token per sessione/modello (SILENZIOSO).
454: # Tabella usage_log nello stesso DB (memory_meta.db). Nessun output a schermo:
455: # record best-effort, mai solleva eccezioni, mai blocca il flusso conversazione.
456: # ---------------------------------------------------------------------------
457: 
458: _USAGE_DDL = """CREATE TABLE IF NOT EXISTS usage_log (
459:     id INTEGER PRIMARY KEY AUTOINCREMENT,
460:     session_id TEXT,
461:     model TEXT,
462:     prompt_tokens INTEGER,
463:     completion_tokens INTEGER,
464:     total_tokens INTEGER,
465:     ts_utc INTEGER
466: )"""
467: _USAGE_IDX = "CREATE INDEX IF NOT EXISTS idx_usage_session_ts ON usage_log(session_id, ts_utc)"
468: _usage_ready = False
469: 
470: 
471: def _uget(usage, key, default=0):
472:     """Lettura campo da usage OpenAI-SDK (attributo) o dict: robustezza doppia."""
473:     if isinstance(usage, dict):
474:         return usage.get(key, default)
475:     return getattr(usage, key, default)
476: 
477: 
478: def record_usage(model, usage, session_id=None):
479:     """Registra i token di una risposta (response.usage). Best-effort: mai solleva.
480:     Silenzioso per design (Fase 3): nessun print, nessun console output."""
481:     try:
482:         if usage is None:
483:             return
484:         global _usage_ready
485:         pt = int(_uget(usage, "prompt_tokens", 0) or 0)
486:         ct = int(_uget(usage, "completion_tokens", 0) or 0)
487:         tt = int(_uget(usage, "total_tokens", 0) or (pt + ct))
488:         sid = session_id or _get_session_id()
489:         with _LOCK:
490:             c = _conn()
491:             try:
492:                 if not _usage_ready:
493:                     c.execute(_USAGE_DDL)
494:                     c.execute(_USAGE_IDX)
495:                     c.commit()
496:                     _usage_ready = True
497:                 c.execute("INSERT INTO usage_log "
498:                           "(session_id, model, prompt_tokens, completion_tokens, total_tokens, ts_utc) "
499:                           "VALUES (?,?,?,?,?,?)",
500:                           (sid, str(model or "unknown")[:120], pt, ct, tt, int(time.time())))
