506:             log_error("memory_meta.usage", e)
507:         except Exception:
508:             pass
509: 
510: 
511: def usage_stats(days=7, session_id=None):
512:     """Aggregate token per finestra `days` (API di query, NON stampate).
513:     Ritorna {'days', 'by_model': [...], 'totals': {...}}."""
514:     since = int(time.time() - days * 86400)
515:     sid_clause = " AND session_id=?" if session_id else ""
516:     params = [since] + ([session_id] if session_id else [])
517:     with _LOCK:
518:         c = _conn()
519:         try:
520:             c.execute(_USAGE_DDL)
521:             c.commit()
522:             rows = c.execute(
523:                 "SELECT model, COUNT(*), SUM(prompt_tokens), SUM(completion_tokens), SUM(total_tokens), "
524:                 "SUM(cached_tokens) "
525:                 "FROM usage_log WHERE ts_utc >= ?" + sid_clause + " GROUP BY model",
526:                 params).fetchall()
527:             tot = c.execute(
528:                 "SELECT SUM(prompt_tokens), SUM(completion_tokens), SUM(total_tokens), SUM(cached_tokens) "
529:                 "FROM usage_log WHERE ts_utc >= ?" + sid_clause,
530:                 params).fetchone()
531:             return {
532:                 "days": days,
533:                 "by_model": [{"model": r[0], "calls": r[1],
534:                               "prompt_tokens": r[2] or 0, "completion_tokens": r[3] or 0,
535:                               "total_tokens": r[4] or 0, "cached_tokens": r[5] or 0}
536:                              for r in rows],
537:                 "totals": {"prompt_tokens": tot[0] or 0,
538:                            "completion_tokens": tot[1] or 0,
539:                            "total_tokens": tot[2] or 0,
540:                            "cached_tokens": tot[3] or 0},
541:             }
542:         finally:
543:             c.close()
544: 
