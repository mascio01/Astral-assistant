441:                 with open(wm_path, "r", encoding="utf-8") as f:
442:                     out["watermark"] = json.load(f)
443:             except Exception:
444:                 out["watermark"] = None
445:         return out
446:     except Exception as e:
447:         log_error("memory_meta.audit", e)
448:         out["error"] = str(e)
449:         return out
