491:     if isinstance(usage, dict):
492:         return usage.get(key, default)
493:     return getattr(usage, key, default)
494: 
495: 
496: def record_usage(model, usage, session_id=None):
497:     """Registra i token di una risposta (response.usage). Best-effort: mai solleva.
498:     Silenzioso per design (Fase 3): nessun print, nessun console output."""
499:     try:
500:         if usage is None:
501:             return
502:         global _usage_ready
503:         pt = int(_uget(usage, "prompt_tokens", 0) or 0)
504:         ct = int(_uget(usage, "completion_tokens", 0) or 0)
505:         tt = int(_uget(usage, "total_tokens", 0) or (pt + ct))
506:         # Token di prompt serviti dalla cache del provider: possono arrivare
507:         # come campo diretto o annidati in prompt_tokens_details.
508:         cached = _uget(usage, "cached_tokens", None)
509:         if cached is None:
510:             det = _uget(usage, "prompt_tokens_details", None)
511:             if det is not None:
512:                 cached = _uget(det, "cached_tokens", 0)
513:         cached = max(0, min(int(cached or 0), pt))
514:         sid = session_id or _get_session_id()
515:         with _LOCK:
516:             c = _conn()
517:             try:
518:                 if not _usage_ready:
519:                     _ensure_usage_schema(c)
520:                     _usage_ready = True
521:                 c.execute("INSERT INTO usage_log "
522:                           "(session_id, model, prompt_tokens, completion_tokens, total_tokens,"
523:                           " cached_tokens, ts_utc) VALUES (?,?,?,?,?,?,?)",
524:                           (sid, str(model or "unknown")[:120], pt, ct, tt,
525:                            cached, int(time.time())))
526:                 c.commit()
527:             finally:
528:                 c.close()
529:     except Exception as e:
530:         try:
531:             log_error("memory_meta.usage", e)
532:         except Exception:
533:             pass
534: 
535: 
536: def usage_stats(days=7, session_id=None):
537:     """Aggregate token per finestra `days` (API di query, NON stampate).
538:     Ritorna {'days', 'by_model': [...], 'totals': {...}}."""
539:     since = int(time.time() - days * 86400)
540:     sid_clause = " AND session_id=?" if session_id else ""
541:     params = [since] + ([session_id] if session_id else [])
542:     with _LOCK:
543:         c = _conn()
544:         try:
545:             _ensure_usage_schema(c)
546:             rows = c.execute(
547:                 "SELECT model, COUNT(*), SUM(prompt_tokens), SUM(completion_tokens), SUM(total_tokens), "
548:                 "SUM(cached_tokens) "
549:                 "FROM usage_log WHERE ts_utc >= ?" + sid_clause + " GROUP BY model",
550:                 params).fetchall()
551:             tot = c.execute(
552:                 "SELECT SUM(prompt_tokens), SUM(completion_tokens), SUM(total_tokens), SUM(cached_tokens) "
553:                 "FROM usage_log WHERE ts_utc >= ?" + sid_clause,
554:                 params).fetchone()
555:             return {
556:                 "days": days,
557:                 "by_model": [{"model": r[0], "calls": r[1],
558:                               "prompt_tokens": r[2] or 0, "completion_tokens": r[3] or 0,
559:                               "total_tokens": r[4] or 0, "cached_tokens": r[5] or 0}
560:                              for r in rows],
