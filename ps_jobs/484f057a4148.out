r {}
                try:
                    p = float(pr.get("prompt") or 0)
                    c = float(pr.get("completion") or 0)
                except (TypeError, ValueError):
                    continue
                if p <= 0 and c <= 0:
                    continue
                out.append({
                    "provider": e.get("provider_name") or e.get("name") or "?",
                    "prompt": p,
                    "completion": c,
                    "latency": e.get("latency_last_30m"),
                    "throughput": e.get("throughput_last_30m"),
                    "uptime_5m": e.get("uptime_last_5m"),
                    "uptime_1d": e.get("uptime_last_1d"),
                    "status": e.get("status"),
                    "quantization": e.get("quantization"),
                    "context_length": e.get("context_length"),
                })
            m["endpoints"] = out
        except Exception:
            m["endpoints"] = []


def _load_openrouter() -> list:
    data = None
    try:
        with open(OR_CACHE, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception:
        data = None
    if not (data and time.time() - data.get("ts", 0) < SYNC_TTL):
        if _sync_openrouter():
            try:
                with open(OR_CACHE, "r", encoding="utf-8") as f:
                    data = json.load(f)
            except Exception:
                data = None
    if not data:
        return []
    out = []
    for m
