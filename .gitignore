# Astral Assistant - .gitignore
# Configurazioni e chiavi
.env
.env.local
*.key
*.pem
*.crt

# Cache Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Log
error_log.txt
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# Sistema Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Whisper models (too large for GitHub)
whisper_bin/Release/ggml-*.bin
whisper_bin/Release/*.bin
whisper_bin/**/*.bin

# Cache benchmark (routing dati reali)
.lb_*
.or_models_cache.json
.lb_sync_state.json

# Stato runtime / telemetria / dati personali (non versionare)
.astral.lock
.astral_heartbeat.tmp
.edge_prof/
.routing_audit.jsonl
.routing_personal_scores.json
.selfmap.json
.selfmap.md
bootstrap.json
bootstrap.md
.watchdog.lock
chat_history.json
checkpoints.db
memory_meta.db
recall.db
telemetry.db
logs/
.verdict_*.tmp
.verdict_out.txt
.verdict_err.txt
subagents/out/

# Dati sensibili BetFlag (cookies, dump DOM/HTTP) - MAI versionare
bf_*.txt
bf_*.html
bf_*.json
.subagent_err.txt
.subagent_out.txt
.subagents_state.json

# Cache scraping
scrape_cache/

# Backup e artefatti di pulizia (mai versionare)
backups/
archive/root_cleanup/
learn_code_repair
progetti/maestro-flow-src
astralBak.py
# Script e file personali non correlati al progetto
survivalist_table.ct
gen_turni_pulizia.py

# Runtime e artefatti diagnostici locali
.session_id
config.db
archive/diagnostics/
.repair_active.lock
.verdict_latency.json
# Knowledge Map: vista generata da selfmap.py (le fonti restano versionate)
knowledge_map.json
knowledge_map.md

chat_history_*.json
_*.py
_*.txt
_*.json
# Eccezione: il supporto condiviso della suite di test e' codice versionato.
# Senza di esso i test_*.py non girano su un clone (la regola _*.py lo escludeva).
!_test_support.py
.astral_sessions.lock*
.repair_last.json
verdict/archive/
__pycache__/
disco_dancer.py
identity.md
state.md
progetti/
