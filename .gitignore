# Astral Assistant - .gitignore
# Configurazioni e chiavi
.env
.env.local
*.key
*.pem
*.crt

# Cache Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Log
error_log.txt
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# Sistema Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Whisper models (too large for GitHub)
whisper_bin/Release/ggml-*.bin
whisper_bin/Release/*.bin
whisper_bin/**/*.bin

# Cache benchmark (routing dati reali)
.lb_*
.or_models_cache.json
.lb_sync_state.json

# Stato runtime / telemetria / dati personali (non versionare)
.astral.lock
.astral_heartbeat.tmp
.edge_prof/
.routing_audit.jsonl
.routing_personal_scores.json
.selfmap.json
.selfmap.md
bootstrap.json
bootstrap.md
.watchdog.lock
chat_history.json
checkpoints.db
memory_meta.db
recall.db
telemetry.db
logs/
.verdict_*.tmp
.verdict_out.txt
.verdict_err.txt
subagents/out/

# Dati sensibili BetFlag (cookies, dump DOM/HTTP) - MAI versionare
bf_*.txt
bf_*.html
bf_*.json
.subagent_err.txt
.subagent_out.txt
.subagents_state.json

# Cache scraping
scrape_cache/

# Backup e artefatti di pulizia (mai versionare)
backups/
archive/root_cleanup/
learn_code_repair
progetti/maestro-flow-src
astralBak.py
# Script e file personali non correlati al progetto
survivalist_table.ct
gen_turni_pulizia.py

# Runtime e artefatti diagnostici locali
.session_id
config.db
archive/diagnostics/
.repair_active.lock
.verdict_latency.json
.verdict_job.json
# Knowledge Map: vista generata da selfmap.py (le fonti restano versionate)
knowledge_map.json
knowledge_map.md

chat_history_*.json
_*.py
_*.txt
_*.json

# Credenziali Google Calendar (MAI versionare - dati personali)
.gcal_tokens/
credentials.json
# Eccezione: il supporto condiviso della suite di test e' codice versionato.
# Senza di esso i test_*.py non girano su un clone (la regola _*.py lo escludeva).
!_test_support.py
# [FIX G08] ui/__init__.py e' codice versionato: la regola _*.py lo escludeva
# per errore, rendendo il package UI non importabile su un clone.
!ui/__init__.py
.astral_sessions.lock*
.repair_last.json
verdict/archive/
__pycache__/
disco_dancer.py
identity.md
state.md
progetti/

# Fantacalcio/interim (solo locale, non versionati)
asta_fantacalcio.py
_tmp_scripts/

# Documenti sensibili: verdict di consiglio e audit di sicurezza (mai versionati)
verdict_smart_home_lite.md
verdicts/
AUDIT-5-SECURITY-RELIABILITY.md

# Catalogo conoscenza e trascrizioni di sessione: solo locali, mai versionati
knowledge_catalog.local.json
RECUPERO_RAGIONAMENTO_*.md


# Credenziali Google Calendar (mai versionare)
.gcal_tokens/
credentials.json
# Turni personali Nico (solo locale)
nico_shifts.json

# ECC skills/agenti: vendorizzati on-demand, non versionati (vedi ecc_bootstrap.py)
ecc_skills/
.ecc_skills_index.json
lazy_bench.py

# Dati personali di analisi bollette (locali, mai versionati)
energia/

# Audit di riparazione automatica (log locale, mai versionato)
.repair_audit.jsonl

# Output generato da graphify (knowledge graph) - MAI versionare
graphify-out/
# Bus runtime locale (segnali, processi, notice): rumore nei commit
.astral_bus/
_defs_temp.txt
_filelist.txt
filter_rules.txt

# Scratch: sempre ignorato (policy Astral)
scratch/

# REA: repository separato (proprio .git, ~5800 file) - mai versionato qui
rea/

# Directory di lavoro REA: APK estratti, output job, inventari (rigenerabili)
work/
_rea_jobs/
stick_inventory.txt

# Android platform-tools: binari di terze parti (~17 MB), da scaricare a parte
tools/platform-tools/

# Cache locale dei modelli OpenRouter (rigenerata a runtime)
.or_live_models.json

ffrs_controller_mapper.py

# --- Artefatti generati / non essenziali al funzionamento di Astral ---
# Job PowerShell e output subagent sono log runtime rigenerabili.
ps_jobs/
agents/out/
# Copia storica di file gia' presenti nella root.
residui/
# Log di test e DB vuoto residuo
error_log_test.txt
memory.db
# Stato sessione locale
.session_checkpoint.json
# Artefatti graphify nella root (la copia viva sta in graphify-out/, gia' ignorata)
/graph.json
/manifest.json
/.graphify_labels*.json
# Documentazione pacchetto upstream Graphify (solo riferimento)
/g_readme.md
/g_pyproject.toml

# Peer bridge: stato runtime locale (inbox/outbox/config con token) - mai versionato
.astral_peer/
# Credenziali e manifest Google Drive (dati personali)
gdrive_token_*.pickle
gdrive_manifest_*.json
# Script locale di upload su Google Drive (contiene percorsi/ID personali)
upload_giove_drive.py
